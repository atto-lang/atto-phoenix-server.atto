// HTTP bounds/deadline probe. No successful response may be issued to
// a declared body larger than the listener's 16 KiB allowance, or to an
// unfinished request line/header section. This does not measure 5s precisely.
pub async routine main(): int {
  val too_large = await network.connect_async("127.0.0.1", 8082);
  await too_large.write_text_async(
    "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: text/plain\r\nContent-Length: 16385\r\nConnection: close\r\n\r\n"
  );
  val rejected_status = await too_large.read_line_async();
  await too_large.close_async();
  if !rejected_status.is_none() &&
     rejected_status.unwrap().starts_with("HTTP/1.1 200"); then
    stdio.println("FAIL oversized declared body was accepted");
    return 1;
  fi

  // Leave the headers incomplete and read until the listener closes or
  // rejects the request. The external per-contract timeout bounds this wait.
  val stalled = await network.connect_async("127.0.0.1", 8082);
  await stalled.write_text_async(
    "GET /hello HTTP/1.1\r\nHost: 127.0.0.1\r\n"
  );
  val timeout_status = await stalled.read_line_async();
  await stalled.close_async();
  if !timeout_status.is_none() &&
     timeout_status.unwrap().starts_with("HTTP/1.1 200"); then
    stdio.println("FAIL incomplete headers received successful response");
    return 1;
  fi

  val String hello = await http.get_text_async("http://127.0.0.1:8082/hello");
  if hello != "hello from oreslang"; then
    stdio.println("FAIL listener not responsive after size/deadline probes");
    return 1;
  fi

  stdio.println("PASS Phoenix-style HTTP bounds and deadline recovery");
  return 0;
}
