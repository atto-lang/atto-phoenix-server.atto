pub async routine main(): int {
  val wrong_method = await network.connect("127.0.0.1", 8082);
  await wrong_method.write_text(
    "POST /hello HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
  );
  val wrong_method_status = await wrong_method.read_line();
  await wrong_method.close();
  if wrong_method_status.is_none() ||
    !wrong_method_status.unwrap().starts_with("HTTP/1.1 405"); then
    stdio.println("FAIL /hello method gate");
    return 1;
  fi

  // Health endpoint must reject state-changing methods, not only accept GET.
  val health_wrong = await network.connect("127.0.0.1", 8082);
  await health_wrong.write_text(
    "POST /healthz HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
  );
  val health_wrong_status = await health_wrong.read_line();
  await health_wrong.close();
  if health_wrong_status.is_none() ||
    !health_wrong_status.unwrap().starts_with("HTTP/1.1 405"); then
    stdio.println("FAIL /healthz method gate");
    return 1;
  fi

  val missing = await network.connect("127.0.0.1", 8082);
  await missing.write_text(
    "GET /missing HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
  );
  val missing_status = await missing.read_line();
  await missing.close();
  if missing_status.is_none() ||
    !missing_status.unwrap().starts_with("HTTP/1.1 404"); then
    stdio.println("FAIL missing route");
    return 1;
  fi

  val wrong_type = await network.connect("127.0.0.1", 8082);
  await wrong_type.write_text(
    "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}"
  );
  val wrong_type_status = await wrong_type.read_line();
  await wrong_type.close();
  if wrong_type_status.is_none() ||
    !wrong_type_status.unwrap().starts_with("HTTP/1.1 415"); then
    stdio.println("FAIL /echo content type gate");
    return 1;
  fi

  // Reject media-type prefix lookalikes; these are not text/plain.
  val bad_prefix = await network.connect("127.0.0.1", 8082);
  await bad_prefix.write_text(
    "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: text/plainx\r\nContent-Length: 4\r\nConnection: close\r\n\r\nping"
  );
  val bad_prefix_status = await bad_prefix.read_line();
  await bad_prefix.close();
  if bad_prefix_status.is_none() ||
    !bad_prefix_status.unwrap().starts_with("HTTP/1.1 415"); then
    stdio.println("FAIL /echo media type prefix gate");
    return 1;
  fi

  // MIME contract: empty parameter
  val empty_mime = await network.connect("127.0.0.1", 8082);
  await empty_mime.write_text(
    "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: text/plain;\r\nContent-Length: 4\r\nConnection: close\r\n\r\nping"
  );
  val empty_mime_status = await empty_mime.read_line();
  await empty_mime.close();
  if empty_mime_status.is_none() ||
    !empty_mime_status.unwrap().starts_with("HTTP/1.1 415"); then
    stdio.println("FAIL /echo MIME empty parameter");
    return 1;
  fi

  // MIME contract: unknown parameter
  val unknown_mime = await network.connect("127.0.0.1", 8082);
  await unknown_mime.write_text(
    "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: text/plain; boundary=unexpected\r\nContent-Length: 4\r\nConnection: close\r\n\r\nping"
  );
  val unknown_mime_status = await unknown_mime.read_line();
  await unknown_mime.close();
  if unknown_mime_status.is_none() ||
    !unknown_mime_status.unwrap().starts_with("HTTP/1.1 415"); then
    stdio.println("FAIL /echo MIME unknown parameter");
    return 1;
  fi

  // MIME contract: non-UTF8 charset
  val wrong_charset = await network.connect("127.0.0.1", 8082);
  await wrong_charset.write_text(
    "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: text/plain; charset=iso-8859-1\r\nContent-Length: 4\r\nConnection: close\r\n\r\nping"
  );
  val wrong_charset_status = await wrong_charset.read_line();
  await wrong_charset.close();
  if wrong_charset_status.is_none() ||
    !wrong_charset_status.unwrap().starts_with("HTTP/1.1 415"); then
    stdio.println("FAIL /echo MIME non-UTF8 charset");
    return 1;
  fi

  // MIME contract: canonical UTF8 positive
  val canonical_charset = await network.connect("127.0.0.1", 8082);
  await canonical_charset.write_text(
    "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 4\r\nConnection: close\r\n\r\nping"
  );
  val canonical_charset_status = await canonical_charset.read_line();
  await canonical_charset.close();
  if canonical_charset_status.is_none() ||
    !canonical_charset_status.unwrap().starts_with("HTTP/1.1 200"); then
    stdio.println("FAIL /echo MIME canonical UTF8 positive");
    return 1;
  fi

  stdio.println("PASS Phoenix-style HTTP negative contracts");
  return 0;
}
