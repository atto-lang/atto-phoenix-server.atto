pub async routine main(): int {
  val wrong_method = await network.connect_async("127.0.0.1", 8082);
  await wrong_method.write_text_async(
    "POST /hello HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
  );
  val wrong_method_status = await wrong_method.read_line_async();
  await wrong_method.close_async();
  if wrong_method_status.is_none() ||
    !wrong_method_status.unwrap().starts_with("HTTP/1.1 405"); then
    stdio.println("FAIL /hello method gate");
    return 1;
  fi

  val missing = await network.connect_async("127.0.0.1", 8082);
  await missing.write_text_async(
    "GET /missing HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
  );
  val missing_status = await missing.read_line_async();
  await missing.close_async();
  if missing_status.is_none() ||
    !missing_status.unwrap().starts_with("HTTP/1.1 404"); then
    stdio.println("FAIL missing route");
    return 1;
  fi

  val wrong_type = await network.connect_async("127.0.0.1", 8082);
  await wrong_type.write_text_async(
    "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}"
  );
  val wrong_type_status = await wrong_type.read_line_async();
  await wrong_type.close_async();
  if wrong_type_status.is_none() ||
    !wrong_type_status.unwrap().starts_with("HTTP/1.1 415"); then
    stdio.println("FAIL /echo content type gate");
    return 1;
  fi

  // Reject media-type prefix lookalikes; these are not text/plain.
  val bad_prefix = await network.connect_async("127.0.0.1", 8082);
  await bad_prefix.write_text_async(
    "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: text/plainx\r\nContent-Length: 4\r\nConnection: close\r\n\r\nping"
  );
  val bad_prefix_status = await bad_prefix.read_line_async();
  await bad_prefix.close_async();
  if bad_prefix_status.is_none() ||
    !bad_prefix_status.unwrap().starts_with("HTTP/1.1 415"); then
    stdio.println("FAIL /echo media type prefix gate");
    return 1;
  fi

  // Method policy applies to both endpoints; HEAD cannot bypass /hello.
  val head_hello = await network.connect_async("127.0.0.1", 8082);
  await head_hello.write_text_async(
    "HEAD /hello HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
  );
  val head_hello_status = await head_hello.read_line_async();
  await head_hello.close_async();
  if head_hello_status.is_none() ||
    !head_hello_status.unwrap().starts_with("HTTP/1.1 405"); then
    stdio.println("FAIL /hello HEAD method gate");
    return 1;
  fi

  val get_echo = await network.connect_async("127.0.0.1", 8082);
  await get_echo.write_text_async(
    "GET /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
  );
  val get_echo_status = await get_echo.read_line_async();
  await get_echo.close_async();
  if get_echo_status.is_none() ||
    !get_echo_status.unwrap().starts_with("HTTP/1.1 405"); then
    stdio.println("FAIL /echo GET method gate");
    return 1;
  fi

  // A missing Content-Type must not default to a permitted text/plain body.
  val missing_type = await network.connect_async("127.0.0.1", 8082);
  await missing_type.write_text_async(
    "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 4\r\nConnection: close\r\n\r\nping"
  );
  val missing_type_status = await missing_type.read_line_async();
  await missing_type.close_async();
  if missing_type_status.is_none() ||
    !missing_type_status.unwrap().starts_with("HTTP/1.1 415"); then
    stdio.println("FAIL /echo absent content type gate");
    return 1;
  fi

  stdio.println("PASS Phoenix-style HTTP negative contracts");
  return 0;
}
