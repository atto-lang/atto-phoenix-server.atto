pub async routine main(): int {
  val wrong_method = await network.connect_async("127.0.0.1", 8082);
  await wrong_method.write_text_async(
    "POST /hello HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
  );
  val wrong_method_status = await wrong_method.read_line_async();
  await wrong_method.close_async();
  if wrong_method_status.is_none() ||
    !wrong_method_status.unwrap().starts_with("HTTP/1.1 405"); then
    stdio.println("FAIL /hello method gate");
    return 1;
  fi

  val missing = await network.connect_async("127.0.0.1", 8082);
  await missing.write_text_async(
    "GET /missing HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
  );
  val missing_status = await missing.read_line_async();
  await missing.close_async();
  if missing_status.is_none() ||
    !missing_status.unwrap().starts_with("HTTP/1.1 404"); then
    stdio.println("FAIL missing route");
    return 1;
  fi

  val wrong_type = await network.connect_async("127.0.0.1", 8082);
  await wrong_type.write_text_async(
    "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}"
  );
  val wrong_type_status = await wrong_type.read_line_async();
  await wrong_type.close_async();
  if wrong_type_status.is_none() ||
    !wrong_type_status.unwrap().starts_with("HTTP/1.1 415"); then
    stdio.println("FAIL /echo content type gate");
    return 1;
  fi

  stdio.println("PASS Phoenix-style HTTP negative contracts");
  return 0;
}
